AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_URL=http://127.0.0.1:3000
GOOGLE_REDIRECT_URI=http://127.0.0.1:3000/api/auth/google/callback

DATABASE_URL=postgres://postgres:postgres@localhost:5432/pet_journal
# 线上用 Supabase 事务池（6543），密码 URL 编码：
# DATABASE_URL=postgres://postgres.项目ref:密码@aws-0-us-west-2.pooler.supabase.com:6543/postgres?sslmode=require

# 写日记：有智谱走 Mastra；都空则用本地模板
ZHIPU_API_KEY=
MASTRA_MODEL_URL=https://open.bigmodel.cn/api/coding/paas/v4
MASTRA_MODEL_ID=custom/glm-5.3-flash

# 出图：空则占位图
ARK_API_KEY=
ARK_BASE=https://ark.ap-southeast.bytepluses.com
SEEDREAM_MODEL_ID=seedream-5-0-260128

# 配图存储（R2 优先；未配且 Vercel 则落 Postgres /api/media）
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=pet-journal
# 公开读 URL：R2 控制台 r2.dev 子域，或自定义域如 https://media.petsdaily.live
R2_PUBLIC_URL=

# Creem 收银台链接。填了之后定价按钮跳到付款页；空着则先去登录。
NEXT_PUBLIC_CREEM_PLUS_URL=
NEXT_PUBLIC_CREEM_FAMILY_URL=

# Paddle.js 客户端 token（live_ 开头，出现在网页里，不是服务端密钥）。空着则付费按钮先去登录。
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
