# ===== 认证（与 petsdaily 同一个 Google 客户端）=====
# 本地回调必须是 http://127.0.0.1:3000/api/auth/google/callback
# 未配置 AUTH_GOOGLE_ID 时仍走 demo 用户
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:3000/api/auth/google/callback

# ===== 生成引擎（IMAGE_PROVIDER / TEXT_PROVIDER 可换成 openrouter）=====
IMAGE_PROVIDER=seedream
ARK_API_KEY=
ARK_BASE=https://ark.ap-southeast.bytepluses.com
SEEDREAM_MODEL_ID=seedream-5-0-260128
SEEDREAM_SIZE=1728x2304

TEXT_PROVIDER=glm
TEXT_API_KEY=
TEXT_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4
TEXT_MODEL=glm-5.3-flash

OPENROUTER_API_KEY=
OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image
OPENROUTER_TEXT_MODEL=google/gemini-2.5-flash

# ===== 数据库（和原来的 PetsDaily 同一条 Postgres。没配时本地用 SQLite）=====
DATABASE_URL=

# ===== 数据库（Supabase JS；没配 DATABASE_URL 时才会用到）=====
# 1. supabase.com 建项目 → SQL Editor 执行 supabase/schema.sql
# 2. 填入以下三项
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ===== 图片存储（Cloudflare R2；未配置时生成图以 data-URL 返回）=====
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=petpics

# ===== 支付（Paddle MoR；未配置时结账走 Mock 流程）=====
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
NEXT_PUBLIC_STORE_STUDIO_ID=
NEXT_PUBLIC_STORE_GIFT_ID=

# ===== 邮件（Resend）=====
RESEND_API_KEY=

# ===== 分析（PostHog）=====
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
