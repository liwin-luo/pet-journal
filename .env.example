# ===== 站点身份（上线必填：换成你买的域名）=====
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Pawtrait
NEXT_PUBLIC_SITE_MAIL=hello@example.com

# ===== 免费额度（每人每天生成次数，可配置）=====
FREE_DAILY_LIMIT=3

# ===== 生成引擎（IMAGE_PROVIDER / TEXT_PROVIDER 可换成 openrouter）=====
# 无密钥时自动用 Mock 引擎（返回占位图），开发不花钱
IMAGE_PROVIDER=seedream
ARK_API_KEY=
ARK_BASE=https://ark.ap-southeast.bytepluses.com
SEEDREAM_MODEL_ID=seedream-5-0-260128
SEEDREAM_SIZE=1728x2304

TEXT_PROVIDER=glm
# 未配置时跳过语义审核门控（仅关键词层）；配置后非宠物诉求/违规内容一律拒绝
TEXT_API_KEY=
TEXT_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4
TEXT_MODEL=glm-5.3-flash

OPENROUTER_API_KEY=
OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image
OPENROUTER_TEXT_MODEL=google/gemini-2.5-flash

# ===== 登录（Google OAuth；下载图片必须登录）=====
# Google Cloud Console → OAuth 客户端，回调登记 {SITE_URL}/api/auth/google/callback
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# 本地开发回调（线上不需要，自动取当前域名）
GOOGLE_REDIRECT_URI=http://127.0.0.1:3000/api/auth/google/callback
# =1 时开放演示登录（仅本地开发用，线上务必关闭）
AUTH_DEMO=
